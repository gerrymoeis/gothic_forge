// Convenience Layout Templates

// SimpleCard creates a card with header, content, and optional footer
templ SimpleCard(header, content, footer string, attrs ...map[string]string) {
	@Card(CardComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Header: header,
		Footer: footer,
		Children: []templ.Component{templ.Raw(content)},
	})
}

// ModalDialog creates a modal dialog with label and content
templ ModalDialog(label, content string, open bool, attrs ...map[string]string) {
	@Dialog(DialogComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Label: label,
		Open: open,
		Children: []templ.Component{templ.Raw(content)},
	})
}

// SideDrawer creates a side drawer with content
templ SideDrawer(label, content string, placement string, open bool, attrs ...map[string]string) {
	@Drawer(DrawerComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Label: label,
		Placement: placement,
		Open: open,
		Children: []templ.Component{templ.Raw(content)},
	})
}

// SimpleTabs creates a tab group from a map of tab labels to content
templ SimpleTabs(tabs map[string]string, activeTab string, attrs ...map[string]string) {
	@TabGroup(TabGroupComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Tabs: createTabsFromMap(tabs, activeTab),
	})
}

// DataTable creates a table with headers and data rows
templ DataTable(headers []string, rows [][]string, caption string, attrs ...map[string]string) {
	@Table(TableComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Headers: headers,
		Rows: rows,
		Caption: caption,
	})
}

// StatusBadge creates a badge with status styling
templ StatusBadge(text, status string, pill bool, attrs ...map[string]string) {
	@Badge(BadgeComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Content: text,
		Variant: status,
		Pill: pill,
	})
}

// LoadingSpinner creates a loading spinner with optional size
templ LoadingSpinner(size string, attrs ...map[string]string) {
	@Spinner(SpinnerComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Size: size,
	})
}

// ProgressIndicator creates a progress bar with value and label
templ ProgressIndicator(value int, label string, attrs ...map[string]string) {
	@ProgressBar(ProgressBarComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Value: value,
		Label: label,
	})
}

// IndeterminateProgress creates an indeterminate progress bar
templ IndeterminateProgress(label string, attrs ...map[string]string) {
	@ProgressBar(ProgressBarComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Indeterminate: true,
		Label: label,
	})
}

// ActionDropdown creates a dropdown with action menu
templ ActionDropdown(buttonText string, actions []MenuItem, attrs ...map[string]string) {
	@Dropdown(CreateSimpleDropdown(buttonText, actions, attrs...))
}

// ContextMenu creates a context menu
templ ContextMenu(items []MenuItem, attrs ...map[string]string) {
	@Menu(CreateContextMenu(items, attrs...))
}

// HelpTooltip creates a help tooltip with question mark icon
templ HelpTooltip(helpText string, attrs ...map[string]string) {
	@Tooltip(CreateHelpTooltip(helpText, attrs...))
}

// ButtonWithTooltip creates a button with tooltip
templ ButtonWithTooltip(buttonText, tooltipText, variant string, attrs ...map[string]string) {
	@Tooltip(CreateTooltipButton(buttonText, tooltipText, variant, attrs...))
}

// Layout Patterns

// TwoColumnLayout creates a two-column layout using cards
templ TwoColumnLayout(leftContent, rightContent string, attrs ...map[string]string) {
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="col-span-1">
			@SimpleCard("", leftContent, "", map[string]string{"class": "h-full"})
		</div>
		<div class="col-span-1">
			@SimpleCard("", rightContent, "", map[string]string{"class": "h-full"})
		</div>
	</div>
}

// ThreeColumnLayout creates a three-column layout using cards
templ ThreeColumnLayout(leftContent, centerContent, rightContent string, attrs ...map[string]string) {
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
		<div class="col-span-1">
			@SimpleCard("", leftContent, "", map[string]string{"class": "h-full"})
		</div>
		<div class="col-span-1">
			@SimpleCard("", centerContent, "", map[string]string{"class": "h-full"})
		</div>
		<div class="col-span-1">
			@SimpleCard("", rightContent, "", map[string]string{"class": "h-full"})
		</div>
	</div>
}

// DashboardLayout creates a dashboard-style layout with header and content areas
templ DashboardLayout(headerContent, mainContent, sidebarContent string, attrs ...map[string]string) {
	<div class="min-h-screen bg-gray-50">
		<!-- Header -->
		<header class="bg-white shadow-sm border-b">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				@templ.Raw(headerContent)
			</div>
		</header>
		
		<!-- Main Content -->
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
			<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
				<!-- Sidebar -->
				<div class="lg:col-span-1">
					@SimpleCard("", sidebarContent, "", map[string]string{"class": "sticky top-8"})
				</div>
				
				<!-- Main Content -->
				<div class="lg:col-span-3">
					@SimpleCard("", mainContent, "")
				</div>
			</div>
		</div>
	</div>
}