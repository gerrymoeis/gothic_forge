// SimpleSelect creates a select with string options
templ SimpleSelect(name string, options []string, attrs ...map[string]string) {
	@Select(SelectComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Name: name,
		Options: stringOptionsToSelectOptions(options),
	})
}

// FormTextarea creates a textarea with common defaults
templ FormTextarea(name, placeholder string, rows int, attrs ...map[string]string) {
	@Textarea(TextareaComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Name: name,
		Placeholder: placeholder,
		Rows: rows,
	})
}

// FormCheckbox creates a checkbox with label
templ FormCheckbox(name, value, label string, checked bool, attrs ...map[string]string) {
	@Checkbox(CheckboxComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Name: name,
		Value: value,
		Label: label,
		Checked: checked,
	})
}

// FormRadio creates a radio button with label
templ FormRadio(name, value, label string, checked bool, attrs ...map[string]string) {
	@Radio(RadioComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Name: name,
		Value: value,
		Label: label,
		Checked: checked,
	})
}

// RadioGroup creates a group of radio buttons
templ RadioGroup(name string, options []RadioOption, selectedValue string, attrs ...map[string]string) {
	<div class="radio-group">
		for _, option := range options {
			@FormRadio(name, option.Value, option.Label, option.Value == selectedValue, attrs...)
		}
	</div>
}

// CheckboxGroup creates a group of checkboxes
templ CheckboxGroup(name string, options []CheckboxOption, attrs ...map[string]string) {
	<div class="checkbox-group">
		for _, option := range options {
			@FormCheckbox(name+"[]", option.Value, option.Label, option.Checked, attrs...)
		}
	</div>
}

// Form creates a form wrapper with Web Awesome styling
templ Form(action, method string, attrs ...map[string]string) {
	<form action={ action } method={ method }>
		{ children... }
	</form>
}

// FormField creates a form field with label and input
templ FormField(label, name, inputType, placeholder string, required bool, attrs ...map[string]string) {
	<div class="form-field">
		<label for={ name } class="form-label">
			{ label }
			if required {
				<span class="text-danger">*</span>
			}
		</label>
		@Input(InputComponent{
			BaseComponent: BaseComponent{
				ID: name,
				Class: "form-input",
			},
			Type: inputType,
			Name: name,
			Placeholder: placeholder,
			Required: required,
		})
	</div>
}

// FormFieldWithError creates a form field with error display
templ FormFieldWithError(label, name, inputType, placeholder, errorMsg string, required bool, attrs ...map[string]string) {
	<div class="form-field">
		<label for={ name } class="form-label">
			{ label }
			if required {
				<span class="text-danger">*</span>
			}
		</label>
		@Input(createInputWithError(name, inputType, placeholder, errorMsg, required))
		if errorMsg != "" {
			<div class="form-error">{ errorMsg }</div>
		}
	</div>
}

// SubmitButton creates a submit button with common styling
templ SubmitButton(text string, loading bool, attrs ...map[string]string) {
	@Button(ButtonComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Variant: "primary",
		Type: "submit",
		Loading: loading,
		Children: []templ.Component{templ.Raw(text)},
	})
}

