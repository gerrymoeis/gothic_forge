package webawesome

// Button creates a Web Awesome button component
templ Button(props ButtonComponent) {
	@templ.Raw(renderComponent(&props))
}

// Input creates a Web Awesome input component
templ Input(props InputComponent) {
	@templ.Raw(renderComponent(&props))
}

// Select creates a Web Awesome select component
templ Select(props SelectComponent) {
	@templ.Raw(renderComponent(&props))
}

// Textarea creates a Web Awesome textarea component
templ Textarea(props TextareaComponent) {
	@templ.Raw(renderComponent(&props))
}

// Checkbox creates a Web Awesome checkbox component
templ Checkbox(props CheckboxComponent) {
	@templ.Raw(renderComponent(&props))
}

// Radio creates a Web Awesome radio component
templ Radio(props RadioComponent) {
	@templ.Raw(renderComponent(&props))
}

// ButtonPrimary creates a primary button with common defaults
templ ButtonPrimary(text string, attrs ...map[string]string) {
	@Button(ButtonComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Variant: "primary",
		Type: "button",
		Children: []templ.Component{templ.Raw(text)},
	})
}

// ButtonSecondary creates a secondary button with common defaults
templ ButtonSecondary(text string, attrs ...map[string]string) {
	@Button(ButtonComponent{
		BaseComponent: mergeBaseAttrs(attrs...),
		Variant: "neutral",
		Type: "button",
		Children: []templ.Component{templ.Raw(text)},
	})
}

