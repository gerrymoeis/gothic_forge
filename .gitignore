# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Binaries and build folders
bin/
dist/
build/

# Air temp directory
/tmp/
tmp/

# IDE/editor settings
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Node (not used, but ignore if present)
node_modules/

# Generated CSS (built by gotailwindcss)
app/styles/output.css

# DaisyUI plugin (fetched by CLI)
app/styles/daisyui.js
app/styles/daisyui-theme.js

# Coverage
coverage.out

# Local environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Built CLI/server binaries in repo root (cross-platform convenience)
/gforge
/server

# Test export folders
dist-test/

# Logs and profiles
*.log
*.prof
profile.out

# Templ generated files (always re-generated)
app/templates/*_templ.go
!app/templates/layout_templ.go

# Ignore scattered test files outside centralized tests/
**/*_test.go
!tests/**/*

# Development/Session documentation (not for public repo)
# Keep: README.md, QUICKSTART.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md, SECURITY.md, LICENSE
