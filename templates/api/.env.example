# Gothic Forge - API Template
# Environment Configuration

# ═══════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════
APP_ENV=development
API_VERSION=v1
API_NAME=My API

# ═══════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Use JSON logging for APIs
LOG_FORMAT=json
PORT=

# ═══════════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════════
JWT_SECRET={{.JWTSecret}}
API_KEY_SALT=<auto-generated>

# JWT token expiration (in hours)
JWT_EXPIRATION_HOURS=24

# ═══════════════════════════════════════════════════════════════
# Database (Required)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/api
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ═══════════════════════════════════════════════════════════════
# Cache (Optional but recommended)
# ═══════════════════════════════════════════════════════════════
VALKEY_URL=
VALKEY_TLS_SKIP_VERIFY=0

# ═══════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════
# Default rate limit (requests per hour)
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=3600

# Burst limit (requests per minute)
BURST_LIMIT_MAX=100
BURST_LIMIT_WINDOW_SECONDS=60

# ═══════════════════════════════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════════════════════════════
# Comma-separated origins, use '*' for development only
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# ═══════════════════════════════════════════════════════════════
# API Documentation
# ═══════════════════════════════════════════════════════════════
# Enable Swagger UI
ENABLE_DOCS=true
DOCS_PATH=/docs

# ═══════════════════════════════════════════════════════════════
# Monitoring & Observability
# ═══════════════════════════════════════════════════════════════
# Enable Prometheus metrics
ENABLE_METRICS=true
METRICS_PATH=/metrics

# Enable pprof endpoints
PPROF_ENABLE=0

# ═══════════════════════════════════════════════════════════════
# Deployment Tokens
# ═══════════════════════════════════════════════════════════════
LEAPCELL_APP_URL=
COCKROACH_API_KEY=
AIVEN_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
