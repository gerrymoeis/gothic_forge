# Gothic Forge - SaaS Template
# Environment Configuration

# ═══════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════
APP_ENV=development
SITE_BASE_URL=http://127.0.0.1:8080
APP_NAME=My SaaS App

# ═══════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
LOG_FORMAT=
PORT=

# ═══════════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════════
JWT_SECRET={{.JWTSecret}}
SESSION_SECRET=<auto-generated>

# ═══════════════════════════════════════════════════════════════
# Database (Required)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@localhost:5432/saas
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ═══════════════════════════════════════════════════════════════
# Cache (Required for sessions)
# ═══════════════════════════════════════════════════════════════
VALKEY_URL=redis://localhost:6379
VALKEY_TLS_SKIP_VERIFY=0

# ═══════════════════════════════════════════════════════════════
# OAuth Providers (Optional)
# ═══════════════════════════════════════════════════════════════
# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback base URL
OAUTH_BASE_URL=http://127.0.0.1:8080

# ═══════════════════════════════════════════════════════════════
# Email (Required for verification/reset)
# ═══════════════════════════════════════════════════════════════
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Or use SendGrid
SENDGRID_API_KEY=

# ═══════════════════════════════════════════════════════════════
# Stripe Billing (Required for subscriptions)
# ═══════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Subscription Plans
STRIPE_PLAN_BASIC=price_...
STRIPE_PLAN_PRO=price_...
STRIPE_PLAN_ENTERPRISE=price_...

# ═══════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# ═══════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════
CORS_ORIGINS=

# ═══════════════════════════════════════════════════════════════
# Feature Flags
# ═══════════════════════════════════════════════════════════════
ENABLE_REGISTRATION=true
ENABLE_OAUTH=true
ENABLE_EMAIL_VERIFICATION=true
REQUIRE_EMAIL_VERIFICATION=false

# ═══════════════════════════════════════════════════════════════
# Deployment Tokens
# ═══════════════════════════════════════════════════════════════
LEAPCELL_APP_URL=
COCKROACH_API_KEY=
AIVEN_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PROJECT_NAME=
