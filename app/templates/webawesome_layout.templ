package templates

import "time"

// WebAwesomeLayout provides a layout optimized for Web Awesome components
templ WebAwesomeLayout(title string) {
  <!doctype html>
  <html lang="en" class="sl-theme-light">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>{ title }</title>
      <link rel="preconnect" href="https://cdn.jsdelivr.net"/>
      
      <!-- Web Awesome CSS -->
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/themes/light.css"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/themes/dark.css"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/shoelace.css"/>
      
      <!-- Tailwind CSS for utility classes -->
      <link rel="stylesheet" href="/static/styles/output.css?v=dev"/>
      <link rel="stylesheet" href="/static/styles/overrides.css"/>
      <link rel="stylesheet" href="/static/styles/webawesome-overrides.css"/>
      
      <!-- Web Awesome JavaScript -->
      <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/shoelace-autoloader.js"></script>
      
      <!-- Application JavaScript -->
      <script defer src="/static/app.js"></script>
      <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp/dist/cdn.min.js"></script>
      <script src="https://unpkg.com/htmx.org"></script>
      
      <!-- Web Awesome Configuration -->
      <script>
        // Set Web Awesome base path for icons and assets
        if (window.SlSetBasePath) {
          window.SlSetBasePath('https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/');
        }
        
        // Theme management
        function setTheme(theme) {
          document.documentElement.classList.remove('sl-theme-light', 'sl-theme-dark');
          document.documentElement.classList.add(`sl-theme-${theme}`);
          localStorage.setItem('webawesome-theme', theme);
        }
        
        // Initialize theme
        document.addEventListener('DOMContentLoaded', function() {
          const savedTheme = localStorage.getItem('webawesome-theme') || 'light';
          setTheme(savedTheme);
        });
      </script>
      
      <!-- Custom Web Awesome styles -->
      <style>
        /* Custom Web Awesome theme overrides */
        :root {
          --sl-font-sans: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
        
        /* Smooth transitions for theme switching */
        html {
          transition: background-color 0.3s ease, color 0.3s ease;
        }
        
        /* Custom navbar styling with Web Awesome */
        .navbar-webawesome {
          background: var(--sl-color-neutral-50);
          border: 1px solid var(--sl-color-neutral-200);
          border-radius: var(--sl-border-radius-medium);
          backdrop-filter: blur(10px);
          box-shadow: var(--sl-shadow-large);
        }
        
        .sl-theme-dark .navbar-webawesome {
          background: var(--sl-color-neutral-900);
          border-color: var(--sl-color-neutral-700);
        }
        
        /* Footer styling */
        .footer-webawesome {
          background: var(--sl-color-neutral-50);
          border: 1px solid var(--sl-color-neutral-200);
          border-radius: var(--sl-border-radius-medium);
        }
        
        .sl-theme-dark .footer-webawesome {
          background: var(--sl-color-neutral-900);
          border-color: var(--sl-color-neutral-700);
        }
      </style>
    </head>
    <body class="min-h-screen" style="background-color: var(--sl-color-neutral-0); color: var(--sl-color-neutral-1000);">
      <!-- Navigation Bar -->
      <nav class="navbar-webawesome mx-4 mt-4 p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <sl-button variant="text" href="/" class="text-xl font-bold">
              Gothic Forge v10
            </sl-button>
          </div>
          <div class="flex items-center space-x-2">
            <!-- Theme Switcher -->
            <sl-dropdown>
              <sl-button slot="trigger" variant="neutral" size="small">
                <sl-icon name="sun" slot="prefix"></sl-icon>
                Theme
              </sl-button>
              <sl-menu>
                <sl-menu-item onclick="setTheme('light')">
                  <sl-icon name="sun" slot="prefix"></sl-icon>
                  Light
                </sl-menu-item>
                <sl-menu-item onclick="setTheme('dark')">
                  <sl-icon name="moon" slot="prefix"></sl-icon>
                  Dark
                </sl-menu-item>
              </sl-menu>
            </sl-dropdown>
          </div>
        </div>
      </nav>
      
      <!-- Main Content -->
      <main class="container mx-auto p-4 md:pt-8">
        { children... }
      </main>
      
      <!-- Footer -->
      <footer class="footer-webawesome mx-4 mt-8 p-4 text-center">
        <p style="color: var(--sl-color-neutral-600);">
          © { time.Now().Year() } Gothic Forge v10 - Powered by Web Awesome
        </p>
      </footer>
    </body>
  </html>
}

// WebAwesomeLayoutSEO provides SEO-optimized Web Awesome layout
templ WebAwesomeLayoutSEO(seo SEO) {
  <!doctype html>
  <html lang="en" class="sl-theme-light">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>{ seo.Title }</title>
      <meta name="description" content={ seo.Description }/>
      <link rel="canonical" href={ seo.Canonical }/>
      <meta property="og:url" content={ seo.Canonical }/>
      <meta property="og:title" content={ seo.Title }/>
      <meta property="og:description" content={ seo.Description }/>
      <meta property="og:image" content={ seo.Image }/>
      <meta name="twitter:image" content={ seo.Image }/>
      <meta name="twitter:card" content="summary_large_image"/>
      <meta name="keywords" content={ seo.Keywords }/>
      @templ.Raw("<script type=\"application/ld+json\">" + seo.JSONLD + "</script>")

      <link rel="preconnect" href="https://cdn.jsdelivr.net"/>
      
      <!-- Web Awesome CSS -->
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/themes/light.css"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/themes/dark.css"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.15.1/cdn/shoelace.css"/>
      
      <!-- Tailwind CSS for utility classes -->
      <link rel="stylesheet" href="/static/styles/output.css?v=dev"/>
