          </div>
          <div class="flex items-center space-x-2">
            <!-- Theme Switcher -->
            <sl-dropdown>
              <sl-button slot="trigger" variant="neutral" size="small">
                <sl-icon name="sun" slot="prefix"></sl-icon>
                Theme
              </sl-button>
              <sl-menu>
                <sl-menu-item onclick="setTheme('light')">
                  <sl-icon name="sun" slot="prefix"></sl-icon>
                  Light
                </sl-menu-item>
                <sl-menu-item onclick="setTheme('dark')">
                  <sl-icon name="moon" slot="prefix"></sl-icon>
                  Dark
                </sl-menu-item>
              </sl-menu>
            </sl-dropdown>
          </div>
        </div>
      </nav>
      
      <!-- Main Content -->
      <main class="container mx-auto p-4 md:pt-8">
        { children... }
      </main>
      
      <!-- Footer -->
      <footer class="footer-webawesome mx-4 mt-8 p-4 text-center">
        <p style="color: var(--sl-color-neutral-600);">
